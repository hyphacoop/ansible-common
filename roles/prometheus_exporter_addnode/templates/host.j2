[
  {
    "targets": ["{{ inventory_hostname }}:{{ node_exporter_port | default(9100) }}"],
    "labels": {{ {'job': monitor_job | default('nodeexporter')}
                 | combine({'__scheme__': node_exporter_scheme} if node_exporter_scheme is defined else {})
                 | combine({'__metrics_path__': node_exporter_path} if node_exporter_path is defined else {})
                 | to_json }}
  }{% if bbb_exporter_port is defined %},
  {
    "targets": ["{{ inventory_hostname }}:{{ bbb_exporter_port }}"],
    "labels": {
        "job": "{{ monitor_job | default('nodeexporter') }}"
    }
  }{% endif %}{% if cadvisor_exporter_port is defined %},
  {
    "targets": ["{{ inventory_hostname }}:{{ cadvisor_exporter_port }}"],
    "labels": {
        "job": "{{ monitor_job | default('nodeexporter') }}"
    }
  }{% endif %}{% for t in prometheus_extra_targets | default([]) %},
  {
    "targets": ["{{ inventory_hostname }}:{{ t.port }}"],
    "labels": {{ {'job': t.job | default(monitor_job | default('nodeexporter'))}
                 | combine({'__scheme__': t.scheme} if t.scheme is defined else {})
                 | combine({'__metrics_path__': t.path} if t.path is defined else {})
                 | combine(t.labels | default({})) | to_json }}
  }{% endfor %}
]
